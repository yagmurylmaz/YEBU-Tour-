# Copy to config/mail.properties (same folder as this example) and fill in real values.
# The app loads resources/mail.properties first, then merges config/mail.properties if present.

mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.starttls.enable=true
mail.smtp.auth=true

mail.user=your.email@gmail.com
mail.password=your_app_password_here

mail.from=your.email@gmail.com
mail.from.name=YEBU Tour Reservation System
