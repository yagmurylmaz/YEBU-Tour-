# Copy to config/mail.properties and fill in real values (config/mail.properties is gitignored).

mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.starttls.enable=true
mail.smtp.auth=true

mail.user=you@gmail.com
mail.password=your_app_password

mail.from=you@gmail.com
mail.from.name=YEBU Tour Reservation System
