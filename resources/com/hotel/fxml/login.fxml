<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.ui.LoginController"
           styleClass="root-pane">

    <VBox alignment="CENTER" spacing="0" maxWidth="440" maxHeight="560"
          styleClass="card">
<VBox alignment="CENTER" spacing="10" styleClass="card-header">
            <ImageView fitHeight="96.0" preserveRatio="true" pickOnBounds="true" styleClass="brand-logo-img">
                <image>
                    <Image url="@../images/logo-yebu.png"/>
                </image>
            </ImageView>
            <Text text="YEBU Tour" styleClass="brand-title"/>
            <Text text="Reservation System" styleClass="brand-subtitle"/>
        </VBox>
<VBox spacing="18" styleClass="card-body">
            <VBox spacing="6">
                <Label text="Email Address" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="name@example.com"
                           styleClass="text-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="text-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

            <Button text="Sign In" onAction="#handleLogin"
                    styleClass="btn-primary" maxWidth="Infinity"/>

            <Separator/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?" styleClass="text-muted"/>
                <Hyperlink text="Register" onAction="#handleGoToRegister"
                           styleClass="link"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
