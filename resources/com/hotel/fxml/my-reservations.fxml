<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.ui.MyReservationsController"
            styleClass="root-pane" prefWidth="1050" prefHeight="680">
    <top>
        <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="12">
            <ImageView fitHeight="38.0" preserveRatio="true" pickOnBounds="true" styleClass="nav-logo-img">
                <image>
                    <Image url="@../images/logo-yebu.png"/>
                </image>
            </ImageView>
            <Text text="My Reservations" styleClass="nav-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#handleBack" styleClass="btn-outline-sm"/>
            <Button text="Log Out" onAction="#handleLogout" styleClass="btn-outline-sm"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="page-container split-layout">
            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label fx:id="infoLabel"/>
                <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                        <TableColumn fx:id="colRoom" text="Room" prefWidth="190"/>
                        <TableColumn fx:id="colCheckIn" text="Check-in" prefWidth="120"/>
                        <TableColumn fx:id="colCheckOut" text="Check-out" prefWidth="120"/>
                        <TableColumn fx:id="colNights" text="Nights" prefWidth="110"/>
                        <TableColumn fx:id="colTotal" text="Amount" prefWidth="130"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
                    </columns>
                </TableView>
                <HBox styleClass="action-row">
                    <Button text="Cancel Selected Reservation" onAction="#handleCancelReservation" styleClass="btn-outline"/>
                </HBox>
            </VBox>

            <VBox spacing="10" prefWidth="340" styleClass="section-card">
                <Label text="Rate Your Stay" styleClass="section-title"/>
                <Label fx:id="selectedReservationLabel" styleClass="text-muted" text="Select a reservation to review"/>
                <Label fx:id="reviewEligibilityLabel" styleClass="text-muted" wrapText="true"/>
                <Label text="Star Rating"/>
                <HBox spacing="6">
                    <ToggleButton fx:id="star1Button" text="★" styleClass="review-star-button"/>
                    <ToggleButton fx:id="star2Button" text="★" styleClass="review-star-button"/>
                    <ToggleButton fx:id="star3Button" text="★" styleClass="review-star-button"/>
                    <ToggleButton fx:id="star4Button" text="★" styleClass="review-star-button"/>
                    <ToggleButton fx:id="star5Button" text="★" styleClass="review-star-button"/>
                </HBox>
                <Label text="Comment"/>
                <TextArea fx:id="reviewCommentArea" promptText="Share your experience..." wrapText="true" prefRowCount="7"/>
                <Button text="Submit Review" onAction="#handleAddReview" styleClass="btn-primary"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
