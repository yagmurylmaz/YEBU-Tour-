<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.ui.RegisterController"
           styleClass="root-pane">

    <VBox alignment="CENTER" spacing="0" maxWidth="460" maxHeight="620"
          styleClass="card">

        <VBox alignment="CENTER" spacing="10" styleClass="card-header">
            <ImageView fitHeight="88.0" preserveRatio="true" pickOnBounds="true" styleClass="brand-logo-img">
                <image>
                    <Image url="@../images/logo-yebu.png"/>
                </image>
            </ImageView>
            <Text text="Create New Account" styleClass="brand-title"/>
        </VBox>

        <VBox spacing="14" styleClass="card-body">
            <VBox spacing="4">
                <Label text="Full Name" styleClass="field-label"/>
                <TextField fx:id="fullNameField" promptText="Your full name"
                           styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="name@example.com"
                           styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="At least 6 characters"
                               styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                               styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Phone" styleClass="field-label"/>
                <TextField fx:id="phoneField" promptText="+1 555 000 0000"
                           styleClass="text-field"/>
            </VBox>

            <Label fx:id="errorLabel"   styleClass="error-label"   wrapText="true"/>
            <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>

            <Button text="Register" onAction="#handleRegister"
                    styleClass="btn-primary" maxWidth="Infinity"/>
            <Hyperlink text="← Back to login" onAction="#handleBackToLogin"
                       styleClass="link"/>
        </VBox>
    </VBox>
</StackPane>
