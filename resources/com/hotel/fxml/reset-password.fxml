<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.ui.ResetPasswordController"
           styleClass="root-pane">

    <VBox alignment="CENTER" spacing="0" maxWidth="460" maxHeight="640"
          styleClass="card">

        <VBox alignment="CENTER" spacing="10" styleClass="card-header">
            <ImageView fitHeight="88.0" preserveRatio="true" pickOnBounds="true" styleClass="brand-logo-img">
                <image>
                    <Image url="@../images/logo-yebu.png"/>
                </image>
            </ImageView>
            <Text text="Reset password" styleClass="brand-title"/>
            <Text text="Enter the code from your email and choose a new password" styleClass="brand-subtitle"/>
        </VBox>

        <VBox spacing="14" styleClass="card-body">
            <VBox spacing="4">
                <Label text="Reset code" styleClass="field-label"/>
                <TextField fx:id="tokenField" promptText="Paste the code from your email"
                           styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="New password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="At least 6 characters"
                               styleClass="text-field"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Confirm new password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your new password"
                               styleClass="text-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>

            <Button text="Update password" onAction="#handleReset"
                    styleClass="btn-primary" maxWidth="Infinity"/>
            <Hyperlink text="← Back to login" onAction="#handleBackToLogin"
                       styleClass="link"/>
        </VBox>
    </VBox>
</StackPane>
